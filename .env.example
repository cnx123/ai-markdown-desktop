# 默认 DeepSeek。应用内「设置」会覆盖这里的值。
# 不要把真实密钥提交到仓库。
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# 语音转写（可选）。引擎优先级：云端接口 → 本机 whisper → Windows 本机识别。
# 留空 ASR_BASE_URL 时先用本机 whisper（npm run asr:setup 安装模型），没有模型再退回 Windows 引擎。
# 填写 OpenAI 兼容的 /audio/transcriptions 接口可再提升准确率。
ASR_BASE_URL=
ASR_MODEL=whisper-1
ASR_API_KEY=
ASR_LANGUAGE=zh

# 本机 whisper 资源位置（可选，默认 %APPDATA%\ai-markdown-desktop\models\whisper）
# WHISPER_BIN_DIR=
# WHISPER_MODEL_PATH=
