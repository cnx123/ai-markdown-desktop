{
  "name": "ai-markdown-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "基于 Electron 与 AI 大模型的智能 Markdown 桌面编辑器",
  "main": "dist/main/index.cjs",
  "scripts": {
    "predev": "node scripts/copy-vditor.mjs",
    "prebuild": "node scripts/copy-vditor.mjs",
    "dev": "npm run build:main && concurrently -k -n vite,main,app \"vite\" \"node scripts/build-main.mjs --watch\" \"npm run dev:electron\"",
    "dev:electron": "wait-on -t 60000 http://127.0.0.1:5173 && electron .",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:main",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "asr:setup": "node scripts/setup-whisper.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.local.aimarkdown",
    "productName": "AI Markdown Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "axios": "^1.8.4",
    "dotenv": "^16.4.7",
    "html-to-docx": "^1.8.0",
    "html2canvas": "^1.4.1",
    "opencc-js": "^1.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reveal.js": "^5.2.1",
    "vditor": "^3.11.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^8.0.3"
  }
}
